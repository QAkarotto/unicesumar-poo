            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "alunos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"registroAcademico\": \"{{raNovo}}\", \"nome\": \"Carla Lima\", \"email\": \"carla@email.com\"}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"raNovo\", \"RA\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Location presente\", function () { pm.response.to.have.header(\"Location\"); });"
            ]
          }
        }
      ]
    },
