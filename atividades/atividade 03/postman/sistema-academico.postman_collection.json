            "api",
            "matriculas",
            "MAT-001"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
