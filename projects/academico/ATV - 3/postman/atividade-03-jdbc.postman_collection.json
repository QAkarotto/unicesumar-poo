{
  "info": {
    "name": "Atividade 03 - JDBC e SQLite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Antes de reiniciar",
      "item": [
        {
          "name": "1. Cadastrar aluno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Retorna o aluno cadastrado', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.identificadorAcademico).to.eql('RA2026010');",
                  "    pm.expect(json.nome).to.eql('Maria Silva');",
                  "    pm.expect(json.email).to.eql('maria.silva@email.com');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identificadorAcademico\": \"RA2026010\",\n  \"nome\": \"Maria Silva\",\n  \"email\": \"maria.silva@email.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/alunos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "alunos"]
            }
          }
        },
        {
