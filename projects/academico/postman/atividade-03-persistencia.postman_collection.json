{
  "info": {
    "name": "Sistema Acadêmico — Atividade 03 (JDBC e SQLite)",
    "description": "Pré-requisito: banco preparado (schema.sql + dados-iniciais.sql) e aplicação iniciada. Execute a pasta 1, encerre e inicie a aplicação novamente, e então execute a pasta 2. Para repetir do zero, prepare o banco outra vez.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "1 - Cadastro e consulta",
      "description": "Execute com o banco recém-preparado.",
      "item": [
        {
          "name": "Cadastrar aluno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP', () => pm.response.to.have.status(201));",
                  "pm.test('JSON esperado', () => pm.expect(pm.response.json().registroAcademico).to.eql('RA2026100'));",
                  "pm.test('Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/alunos/RA2026100'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/alunos",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"registroAcademico\":\"RA2026100\",\"nome\":\"Carla Mendes\",\"email\":\"carla.mendes@example.com\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar aluno cadastrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
