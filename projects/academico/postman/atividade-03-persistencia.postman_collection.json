                  "pm.test('JSON esperado', () => pm.expect(pm.response.json().nome).to.eql('Carla Mendes'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/alunos/RA2026100",
            "header": []
          }
        },
