{
  "info": {
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "Sistema Acadêmico - Atividade 03 (JDBC e SQLite)",
    "description": "Rode a pasta 1 com o banco recém-preparado. Depois pare a API, suba de novo e rode a pasta 2."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "ra", "value": "RA2026010" },
    { "key": "codigoDisciplina", "value": "ED" }
  ],
  "item": [
    {
      "name": "1. Cadastro e consulta",
      "item": [
        {
          "name": "Cadastrar aluno",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('JSON com nome correto', () => pm.expect(pm.response.json().nome).to.eql('Carla Mendes'));",
                  "pm.test('Header Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/alunos/' + pm.collectionVariables.get('ra')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"registroAcademico\":\"{{ra}}\",\"nome\":\"Carla Mendes\",\"email\":\"carla.mendes@example.com\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/alunos"
          }
        },
        {
          "name": "Consultar aluno cadastrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON com email correto', () => pm.expect(pm.response.json().email).to.eql('carla.mendes@example.com'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/alunos/{{ra}}"
          }
        },
        {
          "name": "Cadastrar disciplina",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('JSON com carga horária', () => pm.expect(pm.response.json().cargaHoraria).to.eql(60));",
                  "pm.test('Header Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/disciplinas/' + pm.collectionVariables.get('codigoDisciplina')));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\":\"{{codigoDisciplina}}\",\"nome\":\"Estrutura de Dados\",\"cargaHoraria\":60}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/disciplinas"
          }
        },
        {
          "name": "Consultar disciplina cadastrada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('JSON com nome da disciplina', () => pm.expect(pm.response.json().nome).to.eql('Estrutura de Dados'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/disciplinas/{{codigoDisciplina}}"
          }
        },
        {
          "name": "Consultar aluno inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('Mensagem de erro', () => pm.expect(pm.response.json().mensagem).to.eql('Aluno não encontrado.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/alunos/RA0000000"
          }
        },
        {
          "name": "Consultar disciplina inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 404', () => pm.response.to.have.status(404));",
                  "pm.test('Mensagem de erro', () => pm.expect(pm.response.json().mensagem).to.eql('Disciplina não encontrada.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/disciplinas/XYZ"
          }
        },
        {
          "name": "Cadastrar aluno duplicado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Mensagem de conflito', () => pm.expect(pm.response.json().mensagem).to.eql('Já existe aluno com este registro acadêmico.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"registroAcademico\":\"{{ra}}\",\"nome\":\"Outro Nome\",\"email\":\"outro@example.com\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/alunos"
          }
        },
        {
          "name": "Cadastrar disciplina duplicada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 409', () => pm.response.to.have.status(409));",
                  "pm.test('Mensagem de conflito', () => pm.expect(pm.response.json().mensagem).to.eql('Já existe disciplina com este código.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\"codigo\":\"{{codigoDisciplina}}\",\"nome\":\"Outra\",\"cargaHoraria\":40}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/disciplinas"
          }
        }
      ]
    },
    {
      "name": "2. Depois de reiniciar a API",
      "item": [
        {
          "name": "Aluno continua cadastrado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Nome do aluno preservado', () => pm.expect(pm.response.json().nome).to.eql('Carla Mendes'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/alunos/{{ra}}"
          }
        },
        {
          "name": "Disciplina continua cadastrada",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Carga horária preservada', () => pm.expect(pm.response.json().cargaHoraria).to.eql(60));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/disciplinas/{{codigoDisciplina}}"
          }
        }
      ]
    }
  ]
}
