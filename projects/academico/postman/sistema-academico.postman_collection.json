{
  "info": {
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "name": "Sistema Acadêmico — Atividade 02"
  },
  "variable": [
    {
      "value": "http://localhost:8080",
      "key": "baseUrl"
    },
    {
      "value": "MAT-002",
      "key": "codigoMatricula"
    }
  ],
  "item": [
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP', () => pm.response.to.have.status(200));",
              "pm.test('JSON esperado', () => pm.expect(pm.response.json().registroAcademico).to.eql('RA2026001'));"
            ]
          }
        }
      ],
      "name": "Consultar aluno",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/alunos/RA2026001",
        "header": []
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP', () => pm.response.to.have.status(200));",
              "pm.test('JSON esperado', () => pm.expect(pm.response.json().codigo).to.eql('MAT-001'));"
            ]
          }
        }
      ],
      "name": "Consultar matrícula inicial",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/matriculas/MAT-001",
        "header": []
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP', () => pm.response.to.have.status(201));",
              "pm.test('JSON esperado', () => pm.expect(pm.response.json().situacao).to.eql('ATIVA'));",
              "pm.collectionVariables.set('codigoMatricula', pm.response.json().codigo);",
              "pm.test('Location', () => pm.expect(pm.response.headers.get('Location')).to.eql('/api/matriculas/' + pm.response.json().codigo));"
            ]
          }
        }
      ],
      "name": "Criar matrícula",
      "request": {
        "method": "POST",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "mode": "raw",
          "raw": "{\"registroAcademico\":\"RA2026002\",\"ofertaId\":\"POO-2026-2\"}"
        },
        "url": "{{baseUrl}}/api/matriculas",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ]
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP', () => pm.response.to.have.status(200));",
              "pm.test('JSON esperado', () => pm.expect(pm.response.json().situacao).to.eql('ATIVA'));"
            ]
          }
        }
      ],
      "name": "Consultar matrícula criada",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/matriculas/{{codigoMatricula}}",
        "header": []
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP', () => pm.response.to.have.status(404));",
              "pm.test('JSON esperado', () => pm.expect(pm.response.json().mensagem).to.eql('Aluno não encontrado.'));"
            ]
          }
        }
      ],
      "name": "Aluno inexistente",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/alunos/INEXISTENTE",
        "header": []
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP', () => pm.response.to.have.status(400));",
              "pm.test('JSON esperado', () => pm.expect(pm.response.json().mensagem).to.eql('O aluno já está matriculado nesta oferta.'));"
            ]
          }
        }
      ],
      "name": "Matrícula duplicada",
      "request": {
        "method": "POST",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "mode": "raw",
          "raw": "{\"registroAcademico\":\"RA2026001\",\"ofertaId\":\"POO-2026-2\"}"
        },
        "url": "{{baseUrl}}/api/matriculas",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ]
      }
    },
    {
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status HTTP', () => pm.response.to.have.status(400));",
              "pm.test('JSON esperado', () => pm.expect(pm.response.json().mensagem).to.eql('Informe registroAcademico e ofertaId.'));"
            ]
          }
        }
      ],
      "name": "Campos ausentes",
      "request": {
        "method": "POST",
        "body": {
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{baseUrl}}/api/matriculas",
        "header": [
          {
            "value": "application/json",
            "key": "Content-Type"
          }
        ]
      }
    }
  ]
}
