    {
      "name": "Atividade 03 - Cadastrar aluno",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/alunos",
        "body": {
          "mode": "raw",
          "raw": "{\"registroAcademico\":\"{{novoRA}}\",\"nome\":\"Aluno JDBC Teste\",\"email\":\"jdbc.teste@example.com\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('novoRA', 'RA-' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Aluno retornado', () => pm.expect(pm.response.json().registroAcademico).to.eql(pm.collectionVariables.get('novoRA')));",
              "pm.collectionVariables.set('raCadastrado', pm.response.json().registroAcademico);"
            ]
          }
        }
      ]
    },
