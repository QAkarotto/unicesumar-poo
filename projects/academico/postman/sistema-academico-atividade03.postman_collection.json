                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/alunos",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "alunos"
