          "item": [
            {
              "name": "Cadastrar aluno (201)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                      "pm.test(\"identificadorAcademico = RA2026100\", () => pm.expect(pm.response.json().identificadorAcademico).to.eql(\"RA2026100\"));",
                      "pm.test(\"nome = Maria Souza\", () => pm.expect(pm.response.json().nome).to.eql(\"Maria Souza\"));",
                      "pm.test(\"Location aponta para o recurso\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/alunos/RA2026100\"));"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
