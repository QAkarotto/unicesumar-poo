# Copie para backend/.env. Valores ilustrativos; informe sua configuração local.
# Formato Java properties: sem aspas; use variáveis do sistema para senhas com escapes.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=seugame
DB_USER=seugame_app
DB_PASSWORD=SUBSTITUA_LOCALMENTE
SERVER_PORT=8080
APP_TIME_ZONE=America/Sao_Paulo
CORS_ALLOWED_ORIGINS=http://localhost:5173
# false apenas para HTTP local; true quando a aplicação for servida em HTTPS.
SESSION_COOKIE_SECURE=false
